# =====================================================
# DATABASE (WAJIB)
# =====================================================
# Dev lokal: install Postgres (Docker/native) atau pakai Railway dev DB URL.
# Prod Railway: auto-provisioned kalau link Postgres plugin.
DATABASE_URL="postgresql://user:pass@localhost:5432/gencontent"

# =====================================================
# AUTH (WAJIB) — iron-session
# =====================================================
# Generate baru untuk tiap environment: openssl rand -base64 48
# Server tidak start tanpa ini.
SESSION_PASSWORD="69ba9eee991eff5788830662839ef977e41650c4224b340d19bd9ca2cfb4d0fb"
SESSION_COOKIE_NAME="genc_session"  # optional, default OK

# =====================================================
# STORAGE
# =====================================================
STORAGE_DRIVER="local"            # local | r2
STORAGE_LOCAL_DIR="./storage"     # dipakai kalau STORAGE_DRIVER=local

# R2 (dipakai kalau STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""   # pub-xxx.r2.dev atau custom domain

# =====================================================
# QUEUE
# =====================================================
JOB_QUEUE="memory"                # memory (in-process) | bullmq (Redis)
REDIS_URL="redis://localhost:6379"  # dipakai kalau JOB_QUEUE=bullmq
WORKER_CONCURRENCY="3"            # parallel render (bullmq mode) — turunkan ke 1-2 di Railway starter (RAM 512MB)

# =====================================================
# LLM
# =====================================================
LLM_PROVIDER="gemini"             # gemini | anthropic-gateway | anthropic-direct
LLM_MODEL=""                      # override default per provider (opsional)
GOOGLE_GENERATIVE_AI_API_KEY=""   # provider=gemini
AI_GATEWAY_API_KEY=""             # provider=anthropic-gateway
ANTHROPIC_API_KEY=""              # provider=anthropic-direct

# =====================================================
# RUNTIME (optional overrides)
# =====================================================
# NODE_ENV="production"           # Railway auto-set; jangan taruh di .env.local
# TZ="Asia/Jakarta"               # kalau butuh server-side date formatting Indonesia
# FFMPEG_PATH=""                  # override binary; default pakai ffmpeg-static bundled
# FFPROBE_PATH=""                 # override binary; default pakai system PATH ffprobe
# EMBED_COVER_FRAME="true"        # tuning render output (default true)
# COVER_FRAME_DURATION_SEC="0.15" # tuning cover frame duration
