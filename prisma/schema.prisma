// Data model — see plan.md §3
// Menggunakan SQLite untuk local dev (zero-config).
// Untuk produksi: ganti provider ke "postgresql" dan set DATABASE_URL ke Postgres URL,
// lalu re-migrate. Skema di bawah kompatibel dengan Postgres — hanya perlu tambah
// kembali @db.Text pada kolom string besar (baseCaption, caption, errorMessage) dan
// ubah `layout String` menjadi `layout Json`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id          String      @id @default(cuid())
  handle      String      @unique
  platform    String
  displayName String
  isActive    Boolean     @default(true)
  // Instruksi tambahan khusus akun ini untuk LLM (gaya bahasa, target audiens,
  // referensi brand, dll). Kosongkan untuk pakai global + platform saja.
  promptStyle String?
  template    Template?
  renditions  Rendition[]
  groups      Group[]     @relation("GroupAccounts")
  createdAt   DateTime    @default(now())
}

// Kumpulan Account untuk mempermudah pemilihan di /create.
// Group adalah UI-level convenience; endpoint job/thumbnail tetap bekerja
// dengan flat accountIds. Union group + akun manual di-resolve di server.
model Group {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  accounts    Account[] @relation("GroupAccounts")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Konfigurasi prompt LLM. Singleton — hanya satu row dengan id="global".
// Layer prompt: systemPrompt (global rules) + platform style (TIKTOK/IG/YT)
// + Account.promptStyle (per-akun override).
model PromptConfig {
  id              String   @id @default("global")
  systemPrompt    String
  tiktokStyle     String   @default("")
  instagramStyle  String   @default("")
  youtubeStyle    String   @default("")
  updatedAt       DateTime @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  frameKey  String
  introKey  String?
  width     Int      @default(1080)
  height    Int      @default(1920)
  layout    String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             String      @id @default(cuid())
  sourceKey      String
  sourceDuration Float?
  baseCaption    String
  baseThumbText  String
  status         String      @default("QUEUED")
  renditions     Rendition[]
  createdAt      DateTime    @default(now())
  completedAt    DateTime?
}

model Rendition {
  id                    String    @id @default(cuid())
  jobId                 String
  job                   Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  accountId             String
  account               Account   @relation(fields: [accountId], references: [id])
  status                String    @default("PENDING")
  caption               String?
  thumbText             String?
  outputKey             String?
  thumbnailKey          String?
  thumbnailSource       String?   // "AUTO" | "MANUAL" — null = fallback (extract detik 2 dari output)
  thumbnailTimestampSec Float?    // hanya diisi kalau source = AUTO
  errorMessage          String?
  attempts              Int       @default(0)
  startedAt             DateTime?
  finishedAt            DateTime?

  @@unique([jobId, accountId])
  @@index([jobId, status])
}

// Pre-job async task untuk generate N thumbnail unik dari 1 video source.
// State disimpan di sini supaya UI bisa poll progress; worker (queue existing)
// yang eksekusi. Field JSON di-string karena SQLite; parse di consumer.
model ThumbnailTask {
  id        String   @id @default(cuid())
  sourceKey String
  status    String   @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  progress  String   @default("{}")     // JSON: { done: number, total: number }
  items     String   @default("[]")     // JSON: GeneratedThumb[]
  warnings  String   @default("[]")     // JSON: string[]
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
